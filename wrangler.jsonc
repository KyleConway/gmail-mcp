{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gmail-mcp",
	"main": "src/index.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"migrations": [
		{
			"new_sqlite_classes": ["GmailMCP"],
			"tag": "v1"
		}
	],
	"durable_objects": {
		"bindings": [
			{
				"class_name": "GmailMCP",
				"name": "MCP_OBJECT"
			}
		]
	},
	// No id: every OAuth grant and token lives in this namespace, and each
	// deployment needs its own. `bun run setup` records the id it creates or
	// reuses in wrangler.local.jsonc; a deploy that finds neither has one
	// provisioned on the account it uploads to.
	"kv_namespaces": [
		{
			"binding": "OAUTH_KV"
		}
	],
	"rules": [
		{ "type": "Text", "globs": ["**/*.html"] }
	],
	"vars": {
		// How many distinct Google accounts may ever complete sign-in. Raise it
		// for a shared deployment; Google caps unverified apps at 100 users.
		"MAX_ACCOUNTS": "1",
		// Each Google account is pinned to the first OAuth client that completes
		// a sign-in for it, and any other client is then refused for that account.
		// This stops a link someone sends from connecting their own client to your
		// mailbox once you have connected yours. Setting ALLOWED_CLIENT_IDS takes
		// over from it. Reset an account's pin with
		// `wrangler kv key delete "pin:<address>" --namespace-id <id> --remote`.
		"PIN_FIRST_CLIENT": "true"
		// Optional: the exact redirect URIs a client may sign in with, comma-
		// separated. Unset, only Claude's two callbacks are accepted:
		// https://claude.ai/api/mcp/auth_callback and
		// https://claude.com/api/mcp/auth_callback. Each entry added is one more
		// place an authorization code can be sent, and a localhost entry hands
		// codes to whatever listens on that port of the signing-in machine. A list
		// that is set replaces the default, so name Claude's callbacks in it too.
		// "ALLOWED_REDIRECT_URIS": "https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback"
	},
	"unsafe": {
		"bindings": [
			{
				"name": "RATE_LIMITER",
				"type": "ratelimit",
				"namespace_id": "4207",
				// Gmail calls allowed per account, counted across all its sessions.
				// The binding reads these at build time — limit() takes only a key —
				// so this is where the ceiling is set. The namespace is private to
				// this Worker: another one sharing the number would share the counters.
				"simple": { "limit": 120, "period": 60 }
			},
			{
				"name": "REGISTER_LIMITER",
				"type": "ratelimit",
				"namespace_id": "4208",
				// Client registration is open to anyone with the URL and writes a
				// KV entry each time. A client registers once and then keeps its
				// id, so a caller asking this often is not one.
				"simple": { "limit": 10, "period": 60 }
			}
		]
	},
	// The local redirect URI is registered with Google by hand, so the port has
	// to be the same every run — wrangler otherwise starts at 8787 and moves on
	// to another port whenever that one is taken.
	"dev": {
		"port": 8788
	},
	// Invocation logs would keep every tool call's arguments (the agents SDK
	// forwards them to the session as the cf-mcp-message header), the account
	// address and capability URLs for days. Only console output is kept.
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"invocation_logs": false
		},
		"traces": {
			"enabled": false
		}
	}
	// A deployment answers on workers.dev unless it is given a custom domain,
	// which `bun run setup` writes into wrangler.local.jsonc as a route. Google
	// needs the redirect URI to match whichever host ends up serving /callback.
}
